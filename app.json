{
  "expo": {
    "name": "Memora",
    "slug": "memora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "memora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "supportsTablet": false
    },
    "android": {
      "package": "ar.com.memora.fechas",
      "adaptiveIcon": {
        "backgroundColor": "#E9DFCF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.WRITE_CONTACTS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.DETECT_SCREEN_CAPTURE"
      ],
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9DFCF",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 8,
          "dark": {
            "backgroundColor": "#1F1B17"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B56E4D"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Memora lee tus contactos solo para importar cumpleaños y aniversarios. No los envía a ningún lado."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Memora usa tus fotos solo para los recuerdos que guardás.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Memora usa Face ID para proteger tus datos."
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/500Medium/PlusJakartaSans_500Medium.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "ProximasFechas",
              "label": "Próximas fechas",
              "description": "Lo que viene y cuánto falta",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 10800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "description": "Para acordarte de cumpleaños, aniversarios y cualquier fecha importante.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bd692d8-7053-49d1-ba9e-c10cffa44edf"
      }
    },
    "owner": "binaryjuannn"
  }
}
